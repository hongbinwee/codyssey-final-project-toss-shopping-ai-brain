# Postgres (compose.yaml 기본값과 동일)
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce
# 세션 서명 비밀. 공백이면 개발용 기본값 사용. 운영에서는 반드시 설정
SESSION_SECRET=
# 테스트 사용자 접근 코드 매핑: 코드=auth_subject 쌍, 콤마 구분 (Phase 1 users 테이블과 연결)
TEST_USER_CODES=demo-a=u-a,demo-b=u-b
# LLM Provider (OpenAI 호환 chat completions + tool calling)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_PROVIDER: live | stub (기본: 키 있으면 live, 없으면 stub. stub은 조회만 수행)
LLM_PROVIDER=
